{
	"name": "distributed-wagering-processor",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "bun@1.4.4",
	"engines": {
		"bun": "1.4.4"
	},
	"scripts": {
		"dev": "bun --watch src/main.api.ts",
		"build": "bun build.ts",
		"start": "bun dist/main.api.js",
		"consumer": "bun src/main.consumer.ts",
		"consumer:start": "bun dist/main.consumer.js",
		"publisher": "bun src/main.publisher.ts",
		"publisher:start": "bun dist/main.publisher.js",
		"pending:worker": "bun src/main.pending-worker.ts",
		"pending:worker:start": "bun dist/main.pending-worker.js",
		"sqs:provision": "bun src/platform/messaging/provision-sqs.ts",
		"typecheck": "bun --bun tsc --noEmit",
		"lint": "bun --bun eslint . --max-warnings=0 && bun run architecture",
		"lint:fix": "bun --bun eslint . --fix --max-warnings=0 && bun run architecture",
		"architecture": "bun --bun depcruise src --config .dependency-cruiser.cjs",
		"graph:build": "graphify update .",
		"graph:update": "graphify update .",
		"graph:query": "graphify query",
		"graph:explain": "graphify explain",
		"graph:path": "graphify path",
		"format:check": "bun --bun prettier . --check",
		"format": "bun --bun prettier . --write",
		"test": "bun test",
		"db:migrate": "bun --bun mikro-orm migration:up --config src/platform/persistence/mikro-orm.config.ts",
		"db:rollback": "bun --bun mikro-orm migration:down --config src/platform/persistence/mikro-orm.config.ts",
		"db:status": "bun --bun mikro-orm migration:list --config src/platform/persistence/mikro-orm.config.ts && bun --bun mikro-orm migration:pending --config src/platform/persistence/mikro-orm.config.ts"
	},
	"dependencies": {
		"@aws-sdk/client-sqs": "3.1159.0",
		"@mikro-orm/core": "7.2.5",
		"@mikro-orm/migrations": "7.2.5",
		"@mikro-orm/nestjs": "7.1.0",
		"@mikro-orm/postgresql": "7.2.5",
		"@nestjs/common": "11.2.8",
		"@nestjs/core": "11.2.8",
		"@nestjs/platform-express": "11.2.8",
		"reflect-metadata": "0.2.2",
		"rxjs": "7.8.2"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@mikro-orm/cli": "7.2.5",
		"@nestjs/testing": "11.2.8",
		"@types/bun": "1.4.4",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"prettier": "3.9.10",
		"typescript": "5.9.3",
		"typescript-eslint": "8.72.1"
	}
}
